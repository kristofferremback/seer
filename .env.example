# ---- API (uploads) ----
# OPTIONAL, first-boot only. If set, this pre-workspace token is imported ONCE on
# the first boot as the root workspace's key, so an existing single-user deployment
# keeps uploading. New keys (seer_sk_...) are minted per member per workspace in the
# settings UI; agents authenticate with those, not this value. Leave unset on a
# fresh deployment and mint a key from /settings/<workspace> after signing in.
# API_TOKEN is accepted as an alias if API_KEY is unset.
# API_KEY=carried-over-token

# ---- GitHub ----
# Overseer reaches GitHub only as the GitHub App, through an installation a workspace
# has connected. All six are REQUIRED — the server refuses to boot without them, because
# an instance with no App cannot reach GitHub at all and would fail at the first publish.
# Register an App (even for local dev) and set:
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=   # base64 of the downloaded PEM
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=

# ---- Secrets Seer must read back (envelope encryption) ----
# Only needed once something stores a credential Seer USES on a workspace's behalf --
# a user-supplied GitHub token, say. Secrets Seer only ever CHECKS (api keys, share
# tokens) are hashed instead and need none of this.
#
# Key-encryption keys as comma-separated "id:base64" pairs. Mint one with:
#   openssl rand -base64 32
# Several may be listed at once, which is what makes rotation a no-downtime change:
# add the new key, point ACTIVE at it, re-wrap stored rows, then drop the old one.
# A key still named by any stored envelope must stay here or those rows cannot open.
# SEER_ENCRYPTION_KEYS=v1:REPLACE_ME_32_BYTES_BASE64
# Which key new envelopes are sealed under. Defaults to the first listed.
# SEER_ENCRYPTION_ACTIVE_KEY=v1

# ---- GitHub OAuth application (user credentials) ----
# A SECOND GitHub application, separate from the App above, and separate credentials:
# the App reaches repositories an admin installed it on, this one acts as a person
# across what they can already read. Confusing the two pairs sends a user through the
# wrong consent screen. Optional, and optional as a pair: setting exactly one of them
# fails at boot naming both. Setting both adds the "Connect GitHub account" button in
# settings; without them, pasting a fine-grained token is still the whole flow.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# ---- Viewer auth (Google OIDC) ----
# HMAC key used to sign session cookies. Required unless AUTH_DISABLED=true.
# Use a long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=change-me

# Google OAuth 2.0 credentials. Required unless AUTH_DISABLED=true.
# Create at https://console.cloud.google.com/apis/credentials with the
# authorized redirect URI set to $BASE_URL/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DEPRECATED, first-boot only. No longer an access list: login is checked against
# the users table. Only the FIRST entry is read, once, to seed the root workspace's
# owner on the first boot. After that, membership is managed via invites in the UI.
# Required only on a first boot with auth enabled (unless AUTH_DISABLED=true, which
# makes the root user dev@localhost).
ALLOWED_EMAILS=you@example.com

# Set to "true" to skip Google sign-in entirely (LOCAL DEV ONLY).
# When true, GOOGLE_*, SESSION_SECRET and ALLOWED_EMAILS are not required.
AUTH_DISABLED=false

# ---- Networking ----
# Public base URL of the deployment; used to build OAuth redirects and
# returned upload URLs. Cookies are marked Secure when this is https.
# Defaults to http://localhost:$PORT.
BASE_URL=http://localhost:3000

# Port to listen on. Defaults to 3000.
PORT=3000

# ---- Storage ----
# Directory for the SQLite db and the extraction cache (and, without S3, the
# uploaded blobs). On Railway this should point at the mounted volume.
# Defaults to ./data.
DATA_DIR=./data

# OPTIONAL: store blobs (bundle zips + images) in S3 instead of on disk. When
# S3_BUCKET is set the other three are required (AWS_* names work too), and on
# the first boot any existing local blobs are copied into the bucket (idempotent;
# local files are left in place). SQLite stays local either way.
# S3_BUCKET=
# S3_REGION=eu-north-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# For S3-compatible stores (R2, MinIO, ...) set an endpoint instead of a region:
# S3_ENDPOINT=

# ---- Limits / TTLs ----
# Max upload size in bytes. Defaults to 52428800 (50 MiB).
MAX_UPLOAD_BYTES=52428800

# How long an extracted bundle stays in the cache after its last access,
# in milliseconds. Defaults to 1800000 (30 min).
CACHE_TTL_MS=1800000

# Session cookie lifetime in milliseconds. Defaults to 2592000000 (30 days).
SESSION_TTL_MS=2592000000
