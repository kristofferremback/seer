b5d933904","url":"https://api.github.com/repos/kristofferremback/seer/commits/a5db12f5520902e442ac762a8966292b5d933904","html_url":"https://github.com/kristofferremback/seer/commit/a5db12f5520902e442ac762a8966292b5d933904"}]},{"sha":"86ccd710ad5dd29184a2681f6bde9ce0ceb3fe9e","node_id":"C_kwDOTZUlPdoAKDg2Y2NkNzEwYWQ1ZGQyOTE4NGEyNjgxZjZiZGU5Y2UwY2ViM2ZlOWU","commit":{"author":{"name":"Kristoffer Remback","email":"kristoffer.remback@telnesstech.com","date":"2026-07-19T08:12:20Z"},"committer":{"name":"Kristoffer Remback","email":"kristoffer.remback@telnesstech.com","date":"2026-07-19T08:12:20Z"},"message":"Review fixes: cap+strip guaranteed on every path; cover animated/avif/exif\n\nOpus review findings: the keep-original branch stored raw bytes verbatim,\nvoiding the documented 2000px cap and metadata strip (a geotagged JPEG that\nout-compressed WebP would leak GPS). The fallback is now a same-format\nre-encode through the same pipeline — originals are never stored except SVG.\nFilename regex tightened so \"max 64 chars\" is exact. Added the missing\nbranch tests (animated GIF survives the WebP re-encode, AVIF same-format\nfallback, EXIF orientation baked + metadata gone) and fixed a stale\nschema-v1 comment.\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>","tree":{"sha":"d88ef8f59922a729f922ca8b28f0865b26d6d882","url":"https://api.github.com/repos/kristofferremback/seer/git/trees/d88ef8f59922a729f922ca8b28f0865b26d6d882"},"url":"https://api.github.com/repos/kristofferremback/seer/git/commits/86ccd710ad5dd29184a2681f6bde9ce0ceb3fe9e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/kristofferremback/seer/commits/86ccd710ad5dd29184a2681f6bde9ce0ceb3fe9e","html_url":"https://github.com/kristofferremback/seer/commit/86ccd710ad5dd29184a2681f6bde9ce0ceb3fe9e","comments_url":"https://api.github.com/repos/kristofferremback/seer/commits/86ccd710ad5dd29184a26