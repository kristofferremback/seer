[{"sha":"00d7a201b845e0731d854de189110de29c904000","node_id":"C_kwDOTZUlPdoAKDAwZDdhMjAxYjg0NWUwNzMxZDg1NGRlMTg5MTEwZGUyOWM5MDQwMDA","commit":{"author":{"name":"Kristoffer Remback","email":"kristoffer.remback@telnesstech.com","date":"2026-07-19T07:56:16Z"},"committer":{"name":"Kristoffer Remback","email":"kristoffer.remback@telnesstech.com","date":"2026-07-19T07:56:16Z"},"message":"Image uploads: WebP compression, immutable URLs, GitHub camo carve-out\n\nPUT /api/images/<filename> stores a single image in the key's workspace,\ncompressed on upload (EXIF baked, 2000px cap, WebP when smaller; SVG and\nalready-tight originals pass through; animated GIFs stay animated). Served\nat /<ws>/i/<img_id>/<filename> with immutable caching — the random img id\nmakes every URL a capability link. Visibility follows the workspace, except\nGitHub's camo proxy is always served so images render in PRs/issues/READMEs\neven from a private workspace.\n\nSchema v2 migration adds the images table; skill.md, README, and CLAUDE.md\ndocument the new path.\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>","tree":{"sha":"856e5cd9f299ccff9c21a797b623ea7cd55082e1","url":"https://api.github.com/repos/kristofferremback/seer/git/trees/856e5cd9f299ccff9c21a797b623ea7cd55082e1"},"url":"https://api.github.com/repos/kristofferremback/seer/git/commits/00d7a201b845e0731d854de189110de29c904000","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/kristofferremback/seer/commits/00d7a201b845e0731d854de189110de29c904000","html_url":"https://github.com/kristofferremback/seer/commit/00d7a201b845e0731d854de189110de29c904000","comments_url":"https://api.github.com/repos/kristofferremback/seer/commits/00d7a201b845e0731d854de189110de29c904000/comments","author":{"login":"kristofferremback","id":9280031,"node_id":"MDQ6VXNlcjkyODAwMzE=","avatar_url":"https://avatars.githubusercontent.com/u/9280031?v=4",