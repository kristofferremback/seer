[{"sha":"797ad52d9639e4994778183a0fdbec83ed6afff0","node_id":"C_kwDOTZUlPdoAKDc5N2FkNTJkOTYzOWU0OTk0Nzc4MTgzYTBmZGJlYzgzZWQ2YWZmZjA","commit":{"author":{"name":"Kristoffer Remback","email":"kristoffer.remback@telnesstech.com","date":"2026-07-19T16:41:59Z"},"committer":{"name":"Kristoffer Remback","email":"kristoffer.remback@telnesstech.com","date":"2026-07-19T16:41:59Z"},"message":"S3 blob store: zips and images in S3, boot-time disk migration\n\nWhen S3_BUCKET is set, bundle zips and images live in S3 (Bun's native\nS3Client) and the only durable local state is SQLite. Serving still goes\nthrough Seer — images stream from S3 (never presigned redirects), zips are\npulled into the existing disposable extraction cache. Endpoints, URLs, and\ncompression are unchanged.\n\nA boot-time migration copies existing local blobs into the bucket before\nthe server binds: idempotent (size-checked skips), marker-gated in meta,\nfails loudly if a blob is missing from both stores. Disk mode remains the\ndefault when S3_BUCKET is unset (local dev, tests).\n\nCo-Authored-By: Claude Fable 5 <noreply@anthropic.com>","tree":{"sha":"327d95486f4a9d6548303f6bc980ee404908966e","url":"https://api.github.com/repos/kristofferremback/seer/git/trees/327d95486f4a9d6548303f6bc980ee404908966e"},"url":"https://api.github.com/repos/kristofferremback/seer/git/commits/797ad52d9639e4994778183a0fdbec83ed6afff0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/kristofferremback/seer/commits/797ad52d9639e4994778183a0fdbec83ed6afff0","html_url":"https://github.com/kristofferremback/seer/commit/797ad52d9639e4994778183a0fdbec83ed6afff0","comments_url":"https://api.github.com/repos/kristofferremback/seer/commits/797ad52d9639e4994778183a0fdbec83ed6afff0/comments","author":{"login":"kristofferremback","id":9280031,"node_id":"MDQ6VXNlcjkyODAwMzE=","avatar_url":"https://avatars.githubusercontent.com/u/9280